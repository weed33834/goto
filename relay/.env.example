# Goto Relay 配置示例
# 复制为 .env 并按需修改。所有项均有默认值，不设置则使用默认。

# --- 服务监听 ---
PORT=8787
HOST=0.0.0.0
# 客户端最终连接的 WebSocket 地址（走反代时写 wss://relay.example.com/sync）
PUBLIC_WS_URL=
NODE_ENV=production

# --- Token / 配对码 ---
# 认证 token 有效期（毫秒），默认 24h
TOKEN_TTL_MS=86400000
# 配对码有效期（毫秒），默认 5min
CODE_TTL_MS=300000
# 同一设备创建配对码的最小间隔（毫秒），默认 10s
PAIRING_RATE_LIMIT_MS=10000
# 配对码最大尝试次数，默认 5
MAX_CODE_ATTEMPTS=5

# --- 离线消息队列 ---
# 队列中帧的保留时长（毫秒），默认 7d
QUEUE_TTL_MS=604800000
# 每个 peer 对的最大队列字节数，默认 64MB
MAX_QUEUE_BYTES_PER_PEER=67108864
# 每个 peer 对的最大队列帧数，默认 10000
MAX_QUEUE_FRAMES_PER_PEER=10000

# --- WebSocket ---
# 单帧最大字节数，默认 8MB
MAX_FRAME_SIZE=8388608
# 心跳 ping 间隔（毫秒），默认 30s
PING_INTERVAL_MS=30000
# WebSocket 路径，默认 /sync
# WS_PATH=/sync

# --- HTTP 路由 ---
# 时间戳容差（秒），默认 60
TIMESTAMP_TOLERANCE_SECONDS=60
# JSON body 最大大小，默认 100kb
MAX_BODY_SIZE=100kb

# --- 运维 ---
# store.cleanup() 执行间隔（毫秒），默认 60s
CLEANUP_INTERVAL_MS=60000
# 优雅关闭超时（毫秒），超时后强制退出，默认 10s
SHUTDOWN_TIMEOUT_MS=10000
# CORS 允许的 origin，逗号分隔，默认 *（允许所有）
ALLOWED_ORIGINS=*
# 日志级别
LOG_LEVEL=info
